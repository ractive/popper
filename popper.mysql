#
# Table structure for table 'accounts'
#
CREATE TABLE accounts (
  id int(11) DEFAULT '0' NOT NULL auto_increment,
  user_id int(11) DEFAULT '0' NOT NULL,
  popserver varchar(255),
  poplogin varchar(255),
  poppwd varchar(255),
  fromname varchar(255),
  replyto varchar(255),
  name varchar(255) DEFAULT '' NOT NULL,
  PRIMARY KEY (id)
);

#
# Table structure for table 'addresses'
#
CREATE TABLE addresses (
  id int(11) DEFAULT '0' NOT NULL auto_increment,
  email varchar(255) DEFAULT '' NOT NULL,
  name varchar(255) DEFAULT '' NOT NULL,
  address1 varchar(255),
  address2 varchar(255),
  town varchar(255),
  state varchar(255),
  country varchar(255),
  phone varchar(255),
  mobile varchar(255),
  homepage varchar(255),
  user_id int(11),
  nickname varchar(255),
  lastname varchar(255),
  zip varchar(16),
  PRIMARY KEY (id)
);

#
# Table structure for table 'app'
#
CREATE TABLE app (
  id int(11) DEFAULT '0' NOT NULL auto_increment,
  user_id int(11),
  name varchar(255) DEFAULT '' NOT NULL,
  description text,
  start datetime,
  stop datetime,
  PRIMARY KEY (id)
);

#
# Table structure for table 'conf'
#
CREATE TABLE conf (
  id int(11) DEFAULT '0' NOT NULL auto_increment,
  user_id int(11) DEFAULT '0' NOT NULL,
  keep tinyint(1),
  server_del tinyint(1),
  auto_check tinyint(1),
  signature text,
  app_sig tinyint(1),
  send_direct tinyint(1),
  add_address tinyint(4),
  mail_rows int(11) NOT NULL DEFAULT 20,
  mails_per_page int(11) NOT NULL DEFAULT 20,
  language varchar(20) NOT NULL DEFAULT 'english',
  subject_size int(11) NOT NULL DEFAULT 50,
  address_size int(11) NOT NULL DEFAULT 20,
  check_int int(11) NOT NULL DEFAULT 15,
  PRIMARY KEY (id),
  UNIQUE user_id (user_id)
);

#
# Table structure for table 'confirmations'
#
CREATE TABLE confirmations (
  id int(11) DEFAULT '0' NOT NULL,
  user_id int(11) DEFAULT '0' NOT NULL,
  check char(32)
);

#
# Table structure for table 'mails'
#
CREATE TABLE mails (
  id int(11) DEFAULT '0' NOT NULL auto_increment,
  folder varchar(255),
  user_id int(11),
  uidl varchar(255) DEFAULT '' NOT NULL,
  priority tinyint DEFAULT 0 NOT NULL,
  tos text,
  froms text,
  from_name text,
  subject text,
  is_mime tinyint(1),
  was_read tinyint(1),
  acc_id int(11),
  mail longtext,
  date varchar(14),
  PRIMARY KEY (id),
  KEY uidl (uidl)
);

#
# Table structure for table 'users'
#
CREATE TABLE users (
  id int(11) DEFAULT '0' NOT NULL auto_increment,
  name varchar(255) DEFAULT '' NOT NULL,
  pwd varchar(255),
  email varchar(255),
  activated tinyint(4),
  PRIMARY KEY (id),
  UNIQUE name (name)
);

